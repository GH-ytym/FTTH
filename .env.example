# 填入你自己的 Key；不要在 Key 后面追加注释。
FTTH_API_KEY=

# 以下默认值沿用当前项目的千问配置；如使用其他服务，修改这三项。
FTTH_PROVIDER=qwen
FTTH_MODEL=qwen3.8-flash
FTTH_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
FTTH_MODEL_API=chat
FTTH_ENABLE_THINKING=true

# 本机后端连接；与 QGIS 插件中的地址保持一致。
FTTH_HOST=127.0.0.1
FTTH_PORT=8765
FTTH_QGIS_ROOT=D:/osgeo
FTTH_DATA_DIR=runtime

# .env 是本机文件，已被 Git 忽略。请勿分享填过 Key 的文件。
# 值按原文读取，不执行命令、不展开变量；注释须单独占一行。
